{
  "name": "mergeline",
  "displayName": "Mergeline — Git Graph, History & Branch Actions",
  "description": "Interactive git commit graph for VS Code, Cursor and VSCodium. Checkout, merge, rebase, cherry-pick, revert, reset, tag and stash right from the graph. Free, open source, no account, no telemetry.",
  "version": "0.12.0",
  "publisher": "plainbyte",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://janwan2003.github.io/vscode-commit-graph/",
  "repository": {
    "type": "git",
    "url": "https://github.com/janwan2003/vscode-commit-graph.git"
  },
  "bugs": {
    "url": "https://github.com/janwan2003/vscode-commit-graph/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git graph",
    "file history",
    "git file history",
    "git history",
    "commit graph",
    "git diff",
    "compare branches",
    "branch graph",
    "git log",
    "git tree",
    "git worktree",
    "edit commit message",
    "squash commits",
    "drop commit",
    "reorder commits",
    "interactive rebase",
    "rebase continue",
    "pull request",
    "create pull request",
    "filter branches",
    "code review",
    "fixup commit",
    "merge editor",
    "git remote",
    "merge conflict",
    "git",
    "merge",
    "rebase",
    "cherry-pick",
    "stash"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onWebviewPanel:mergeline.graph"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Mergeline runs git commands in the workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mergeline.show",
        "title": "Show Commit Graph",
        "category": "Mergeline",
        "icon": "$(git-merge)"
      },
      {
        "command": "mergeline.refresh",
        "title": "Refresh Commit Graph",
        "category": "Mergeline"
      },
      {
        "command": "mergeline.manageRemotes",
        "title": "Manage Remotes",
        "category": "Mergeline",
        "icon": "$(repo)"
      },
      {
        "command": "mergeline.fileHistory",
        "title": "Show File History in Mergeline",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "mergeline.show",
          "when": "scmProvider == git",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "mergeline.refresh",
          "when": "mergeline.panelOpen"
        },
        {
          "command": "mergeline.fileHistory",
          "when": "editorIsOpen"
        }
      ],
      "explorer/context": [
        {
          "command": "mergeline.fileHistory",
          "when": "resourceScheme == file && !explorerResourceIsRoot",
          "group": "7_mergeline@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "mergeline.fileHistory",
          "when": "resourceScheme == file",
          "group": "7_mergeline@1"
        }
      ],
      "editor/context": [
        {
          "command": "mergeline.fileHistory",
          "when": "resourceScheme == file",
          "group": "7_mergeline@1"
        }
      ]
    },
    "configuration": {
      "title": "Mergeline",
      "properties": {
        "mergeline.initialCommits": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "How many commits to load first. More load as you scroll or click Load more."
        },
        "mergeline.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show remote-tracking branches in the graph."
        },
        "mergeline.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "Show stashes in the graph."
        },
        "mergeline.showUncommitted": {
          "type": "boolean",
          "default": true,
          "description": "Show a row for uncommitted changes above HEAD."
        },
        "mergeline.commitOrder": {
          "type": "string",
          "enum": [
            "date",
            "topo",
            "author-date"
          ],
          "enumDescriptions": [
            "Newest commit first, by commit date.",
            "Keep each branch's commits together (fewer crossing lines on busy histories).",
            "Newest first, by author date."
          ],
          "default": "date",
          "description": "Order of commits in the graph. Also switchable from the graph toolbar."
        },
        "mergeline.statusBarButton": {
          "type": "boolean",
          "default": true,
          "description": "Show a Mergeline button in the status bar."
        },
        "mergeline.dateFormat": {
          "type": "string",
          "enum": [
            "relative",
            "iso",
            "locale"
          ],
          "default": "relative",
          "description": "How commit dates are shown."
        },
        "mergeline.firstParentOnly": {
          "type": "boolean",
          "default": false,
          "description": "Follow only the first parent of merge commits (git log --first-parent): each branch shows its own line, and a merged branch's commits are hidden behind the merge. The toolbar's First parent checkbox changes this setting."
        },
        "mergeline.dimOtherCommits": {
          "type": "boolean",
          "default": false,
          "description": "Dim commits that are not in the checked-out branch's history, so its line stands out."
        },
        "mergeline.showAvatars": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show author avatars in the graph and the details pane. Off by default: when on, VS Code loads images from `avatars.githubusercontent.com` (GitHub noreply emails) or `gravatar.com` (an MD5 hash of the email). Authors without an avatar show their initials."
        },
        "mergeline.issueLinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "Turn issue keys in commit messages into links, e.g. Jira: `[{ \"pattern\": \"\\\\b[A-Z][A-Z0-9]+-\\\\d+\\\\b\", \"url\": \"https://yourcompany.atlassian.net/browse/$0\" }]`. `pattern` is a JavaScript regular expression; in `url`, `$0` is the whole match and `$1`… are its groups. GitHub, GitLab and Bitbucket `#123` links work without this.",
          "items": {
            "type": "object",
            "required": ["pattern", "url"],
            "properties": {
              "pattern": { "type": "string", "description": "JavaScript regular expression, e.g. \\b[A-Z][A-Z0-9]+-\\d+\\b" },
              "url": { "type": "string", "description": "Link template: $0 is the whole match, $1… the groups. Must start with http:// or https://." }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/ext/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "esbuild src/ext/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --minify && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0"
}
